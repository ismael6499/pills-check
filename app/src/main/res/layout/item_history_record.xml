<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tv_history_date_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Taken on 2026-10-31 at 14:15"
        android:textColor="@color/accent_green"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tv_history_details"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:lineSpacingExtra="3dp"
        android:text="Folcres: 12 pills remaining\nMinoxidil: 3 pills remaining\nVitamin D: 3 capsules remaining"
        android:textColor="@color/text_secondary"
        android:textSize="13sp" />

</LinearLayout>
