<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_root_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card_rounded"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Card Header Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@id/header_badges"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_med_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Folcres (Finasteride 1mg)"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_med_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Silver • 30 Tabs • Blue"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/header_badges"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_yesterday_post"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#2638BDF8"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:text="Yesterday: 13"
                android:textColor="#7DD3FC"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tv_med_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_badge_rounded"
                android:paddingHorizontal="7dp"
                android:paddingVertical="3dp"
                android:text="13/30"
                android:textColor="@color/primary_light"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>
    </RelativeLayout>

    <!-- Visual Blister Canvas -->
    <com.nitsutech.pillscheck.ui.BlisterCanvasView
        android:id="@+id/blister_canvas"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp" />

    <!-- Card Footer Row -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@id/footer_actions"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_reserve_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Res: 3 bl. (90 pills)"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                android:text="|"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/tv_supply_days"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="103 days"
                android:textColor="@color/accent_green"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/footer_actions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_blister"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:text="@string/btn_open_blister"
                android:textAllCaps="false"
                android:textColor="@color/text_primary"
                android:textSize="11sp"
                app:cornerRadius="6dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_manage_stock"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:minWidth="0dp"
                android:paddingHorizontal="8dp"
                android:paddingVertical="0dp"
                android:text="@string/btn_manage_stock"
                android:textAllCaps="false"
                android:textColor="@color/primary_light"
                android:textSize="11sp"
                app:cornerRadius="6dp"
                app:strokeColor="@color/border_card"
                app:strokeWidth="1dp" />
        </LinearLayout>
    </RelativeLayout>

</LinearLayout>
